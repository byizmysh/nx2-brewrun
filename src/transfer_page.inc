static const char page[] =
    "<!doctype html><html lang=en><meta charset=utf-8>"
    "<meta name=viewport content='width=device-width,initial-scale=1'>"
    "<title>NX2 BreRun Transfers</title><style>"
    "body{color-scheme:dark;font:1rem system-ui;background:#0d1421;color:#f4f7fc;margin:8vh auto;padding:1rem;max-width:36rem}"
    "header{display:flex;align-items:center;gap:1rem;margin-bottom:1.25rem}header img{width:64px;height:64px;border-radius:.85rem}"
    "h1{margin:0;font-size:clamp(1.4rem,5vw,1.85rem)}header p{margin:.3rem 0 0;color:#bed0e3}"
    "form{background:#1b2940;border:1px solid #30445d;border-radius:1rem;padding:1.5rem}label,progress,output{display:block;margin:1rem 0}"
    "button,input::file-selector-button{border:1px solid transparent;border-radius:.6rem;padding:.65rem .9rem;margin:0 .45rem .5rem 0;font:inherit;cursor:pointer}"
    "button{background:#8ce8d7;color:#0d1421}button.secondary,input::file-selector-button{background:#283d56;color:#f4f7fc;border-color:#49627c}"
    "button.danger{background:#39293c;color:#ffd5d9;border-color:#845762}button:disabled{opacity:.5;cursor:default}"
    "button:focus-visible,input:focus-visible{outline:2px solid #8ce8d7;outline-offset:3px}"
    "input{max-width:100%;font:inherit}input[type=file]{display:block;margin-top:.5rem;width:100%;color:#bed0e3}"
    "#c{display:block;width:12ch;margin-top:.5rem;padding:.55rem .75rem;border:1px solid #49627c;border-radius:.6rem;"
    "background:#0d1421;color:#f4f7fc;letter-spacing:.12em}"
    "input[type=file]:disabled{opacity:.55}progress{width:100%;accent-color:#8ce8d7}"
    "li{overflow-wrap:anywhere;margin:.5rem 0}</style>"
    "<header><img src='/brand.png' alt='' width=64 height=64><div><h1>NX2 BreRun Transfers</h1>"
    "<p>Select the same NUP file to resume a transfer.</p></div></header>"
    "<form id=f><label>NUP files <input id=n type=file accept='.nup' multiple required></label>"
    "<label>Code shown on the console <input id=c inputmode=numeric autocomplete=off maxlength=8 pattern='[0-9]{8}' required></label>"
    "<button id=b>Send files</button><button id=t class=secondary type=button disabled>Pause</button>"
    "<button id=d class=danger type=button>Cancel transfer</button>"
    "<progress id=p max=1 value=0></progress><output id=s aria-live=polite></output><ol id=q></ol></form>"
    "<script>const $=id=>document.getElementById(id),f=$('f'),n=$('n'),c=$('c'),b=$('b'),t=$('t'),d=$('d'),p=$('p'),s=$('s'),q=$('q');"
    "const sample=65536;let active=null,current=null,last=null,paused=false;"
    "async function hash(blob){let h=2166136261;for(const byte of new Uint8Array(await blob.arrayBuffer()))h=Math.imul(h^byte,16777619);"
    "return(h>>>0).toString(16).padStart(8,'0')}"
    "async function headers(file){const middle=Math.floor(file.size/2),end=Math.max(0,file.size-sample);"
    "const keys=await Promise.all([hash(file.slice(0,sample)),hash(file.slice(middle,middle+sample)),hash(file.slice(end))]);"
    "return{'X-BrewRun-Code':c.value,'X-BrewRun-Name':encodeURIComponent(file.name),"
    "'X-BrewRun-Size':String(file.size),'X-BrewRun-Key':keys.join('')}}"
    "async function query(path,h){const r=await fetch(path,{method:'POST',headers:h});"
    "if(!r.ok)throw Error(await r.text());return r.json()}"
    "function send(file,h,offset){return new Promise((ok,fail)=>{const x=new XMLHttpRequest();active=x;"
    "x.open('POST','/upload');for(const [key,value] of Object.entries(h))x.setRequestHeader(key,value);"
    "x.setRequestHeader('X-BrewRun-Offset',String(offset));"
    "x.upload.onprogress=e=>{p.value=(offset+e.loaded)/file.size;if(offset+e.loaded===file.size)s.textContent='Checking file on SD card…'};"
    "x.onload=()=>x.status===201?ok(x.responseText):fail(Error(x.responseText||'Transfer failed.'));"
    "x.onerror=()=>fail(Error('Connection closed. Select the same file to check saved progress.'));"
    "x.onabort=()=>fail(Error('Paused. Select the same file to resume.'));x.send(file.slice(offset))})}"
    "function busy(value){b.disabled=n.disabled=c.disabled=value;t.disabled=!value;d.disabled=false}"
    "async function discard(job){const h=job.headers||await headers(job.file);await query('/discard',h);"
    "p.value=0;s.textContent='Transfer cancelled. Partial data removed.';"
    "if(job.row)job.row.textContent=job.file.name+' — cancelled';last=null}"
    "n.onchange=()=>{last=null};"
    "t.onclick=()=>{paused=true;if(active)active.abort()};"
    "f.onsubmit=async e=>{e.preventDefault();busy(true);paused=false;q.replaceChildren();"
    "const files=Array.from(n.files);const rows=files.map(file=>{const li=document.createElement('li');"
    "li.textContent=file.name+' — waiting';q.append(li);return li});"
    "try{for(let i=0;i<files.length&&!paused;i++){const file=files[i],li=rows[i];p.value=0;"
    "const job=current=last={file,row:li,cancel:false};"
    "li.textContent=file.name+' — checking';s.textContent='Checking saved progress…';"
    "try{const h=job.headers=await headers(file);if(paused)throw Error('Paused. Select the same file to resume.');"
    "const state=await query('/resume',h),offset=state.offset;"
    "if(!Number.isSafeInteger(offset)||offset<0||offset>file.size)throw Error('Invalid saved position.');"
    "if(offset&&await hash(file.slice(Math.max(0,offset-sample),offset))!==state.tail)"
    "throw Error('This file does not match the saved position. Select the original file.');"
    "if(paused)throw Error('Paused. Select the same file to resume.');"
    "p.value=offset/file.size;s.textContent=offset?'Resuming…':'Sending…';li.textContent=file.name+' — '+s.textContent;"
    "s.textContent=await send(file,h,offset);p.value=1;li.textContent=file.name+' — saved';last=null;"
    "}catch(error){try{if(job.cancel)await discard(job);else throw error;}catch(failure){"
    "s.textContent=failure.message;li.textContent=file.name+' — '+failure.message;}break}finally{active=current=null}}"
    "}finally{busy(false)}};"
    "d.onclick=async()=>{if(!c.reportValidity())return;const job=current||last||(n.files.length===1?{file:n.files[0]}:null);"
    "if(!job){s.textContent='Select the NUP file to cancel its transfer.';return}"
    "if(!confirm('Cancel the transfer of '+job.file.name+' and delete its partial data from the SD card?'))return;"
    "if(current){current.cancel=paused=true;t.disabled=d.disabled=true;if(active)active.abort();return}"
    "busy(true);t.disabled=d.disabled=true;try{await discard(job)}"
    "catch(error){s.textContent=error.message}finally{busy(false)}};"
    "</script></html>";
